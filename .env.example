# Copy to .env and fill in.
ANTHROPIC_API_KEY=sk-ant-...
# Optional overrides
ESP_MODEL=claude-opus-5
ESP_HOST=127.0.0.1
ESP_PORT=8800
ESP_MAX_UPLOAD_MB=50
# Shared password protecting the whole app. Set this before any public deployment.
ESP_PASSWORD=
# Optional: session signing key and lifetime
ESP_SECRET=
ESP_SESSION_HOURS=12
# Set to /esp when ESP is served under a sub-path behind a reverse proxy.
# cPanel "Setup Python App" (Passenger) sets this automatically - leave it empty there.
ESP_ROOT_PATH=
# Ask AI reasoning effort: low | medium (default) | high | xhigh
ESP_AI_EFFORT=medium
